{
  "name": "spark-mcp-remote",
  "version": "0.1.0",
  "description": "Reach your Spark mailbox from Claude mobile and claude.ai: bridges the official Spark (Readdle) stdio MCP server over Streamable HTTP with a built-in OAuth 2.1 authorization server, so it works as a custom connector",
  "main": "src/server.js",
  "scripts": {
    "test": "node test/smoke.js && node test/oauth.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "setup": "bash scripts/setup.sh"
  },
  "keywords": [
    "spark",
    "mcp",
    "email",
    "claude",
    "oauth",
    "connector"
  ],
  "author": "Kevin Colten",
  "license": "MIT",
  "type": "module",
  "bin": {
    "spark-mcp-remote": "src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kevincolten/spark-mcp-remote.git"
  },
  "engines": {
    "node": ">=20.6"
  }
}
