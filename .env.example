# Required, >= 24 chars. openssl rand -base64 32
# This is NOT a bearer token: /mcp accepts only tokens the server issues over
# OAuth. This value is what the OAuth consent screen checks, and the HMAC key
# that signs every issued token — so rotating it revokes all of them.
SPARK_MCP_TOKEN=
PORT=8787
# Bind address. 127.0.0.1 reaches only this machine. Set it to this machine's
# Tailscale IP (tailscale ip -4) to serve every device on the tailnet — that is
# the intended deployment, and it needs no tunnel, no public DNS, no TLS cert.
# Never 0.0.0.0: that exposes the bridge on every network the machine joins.
HOST=127.0.0.1
MCP_PATH=/mcp
# External origin used in the OAuth metadata. Derived per request from the Host
# header (and X-Forwarded-Proto/Host if something is proxying); pin it only when
# clients reach the bridge by a name this server never sees.
# SPARK_MCP_PUBLIC_URL=http://your-mac.your-tailnet.ts.net:8787
# Path to readdle's server/index.js. Defaults to vendor/spark-claude-extension/server/index.js (npm run setup).
# SPARK_MCP_ENTRY=/Users/you/Library/Application Support/Claude/Claude Extensions/local.mcpb.Spark.Spark/server/index.js
# Passed through to the upstream server (override spark CLI location)
# SPARK_PATH=/usr/local/bin/spark
# Block all write tools (draft/comment/action/contact-action/event)
# SPARK_MCP_READ_ONLY=1
# Allow send-level tools (event tool, action send/unschedule). Off by default.
# SPARK_MCP_ALLOW_SEND=1
