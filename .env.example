# Required. openssl rand -base64 32
SPARK_MCP_TOKEN=
PORT=8787
HOST=127.0.0.1
MCP_PATH=/mcp
# Path to readdle's server/index.js. Defaults to vendor/spark-claude-extension/server/index.js (npm run setup).
# SPARK_MCP_ENTRY=/Users/you/Library/Application Support/Claude/Claude Extensions/local.mcpb.Spark.Spark/server/index.js
# Passed through to the upstream server (override spark CLI location)
# SPARK_PATH=/usr/local/bin/spark
# Block all write tools (draft/comment/action/contact-action/event)
# SPARK_MCP_READ_ONLY=1
# Allow send-level tools (event tool, action send/unschedule). Off by default.
# SPARK_MCP_ALLOW_SEND=1
